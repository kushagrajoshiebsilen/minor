# ==============================================================================
# KarigarBazaar — Provider-Agnostic AI Configuration (Zero Re-Training Needed)
# ==============================================================================
# Switch AI_PROVIDER between: grok | gemini | groq | openai
# Just change AI_PROVIDER and paste the matching API key — all craft prompts,
# JSON schemas, GI-tag knowledge, pricing logic, and 15-language rules transfer
# automatically with zero retraining!

AI_PROVIDER=grok

# 1. xAI Grok (Default) — https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-3-mini
XAI_VISION_MODEL=grok-2-vision-1212

# 2. Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. GroqCloud — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# 4. OpenAI — https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
